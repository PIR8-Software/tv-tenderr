<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1a1a2e">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_back"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Settings"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <!-- Backend URL -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Backend Server"
            android:textColor="#2ecc71"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etBackendUrl"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="http://localhost:8899"
            android:textColor="@android:color/white"
            android:textColorHint="#666"
            android:background="@drawable/search_bg"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:inputType="textUri"
            android:singleLine="true"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etApiToken"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="API token"
            android:textColor="@android:color/white"
            android:textColorHint="#666"
            android:background="@drawable/search_bg"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:inputType="textPassword"
            android:singleLine="true"
            android:layout_marginBottom="20dp" />

        <!-- Radarr -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Radarr (Movies)"
            android:textColor="#2ecc71"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etRadarrUrl"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="http://localhost:7878"
            android:textColor="@android:color/white"
            android:textColorHint="#666"
            android:background="@drawable/search_bg"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:inputType="textUri"
            android:singleLine="true"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etRadarrKey"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="API Key"
            android:textColor="@android:color/white"
            android:textColorHint="#666"
            android:background="@drawable/search_bg"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:inputType="textPassword"
            android:singleLine="true"
            android:layout_marginBottom="20dp" />

        <!-- Sonarr -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sonarr (TV Shows)"
            android:textColor="#2ecc71"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etSonarrUrl"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="http://localhost:8989"
            android:textColor="@android:color/white"
            android:textColorHint="#666"
            android:background="@drawable/search_bg"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:inputType="textUri"
            android:singleLine="true"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etSonarrKey"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="API Key"
            android:textColor="@android:color/white"
            android:textColorHint="#666"
            android:background="@drawable/search_bg"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:inputType="textPassword"
            android:singleLine="true"
            android:layout_marginBottom="20dp" />

        <!-- Plex -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Plex"
            android:textColor="#2ecc71"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etPlexUrl"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="http://localhost:32400"
            android:textColor="@android:color/white"
            android:textColorHint="#666"
            android:background="@drawable/search_bg"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:inputType="textUri"
            android:singleLine="true"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etPlexToken"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Plex Token"
            android:textColor="@android:color/white"
            android:textColorHint="#666"
            android:background="@drawable/search_bg"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:inputType="textPassword"
            android:singleLine="true"
            android:layout_marginBottom="32dp" />

        <!-- TMDb -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TMDb (Discover)"
            android:textColor="#2ecc71"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etTmdbKey"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="TMDb API Key"
            android:textColor="@android:color/white"
            android:textColorHint="#666"
            android:background="@drawable/search_bg"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:inputType="textPassword"
            android:singleLine="true"
            android:layout_marginBottom="32dp" />

        <!-- Quality Profiles -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quality Settings"
            android:textColor="#2ecc71"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Radarr Quality Profile"
            android:textColor="#aaa"
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spinnerRadarrQuality"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/search_bg"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sonarr Quality Profile"
            android:textColor="#aaa"
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spinnerSonarrQuality"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/search_bg"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Radarr Root Folder"
            android:textColor="#aaa"
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spinnerRadarrRoot"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/search_bg"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sonarr Root Folder"
            android:textColor="#aaa"
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spinnerSonarrRoot"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/search_bg"
            android:layout_marginBottom="32dp" />

        <!-- Save Button -->
        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Save Settings"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#2ecc71"
            android:layout_marginBottom="8dp" />

        <!-- Status -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#888"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Help / Instructions -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="How to Use"
            android:textColor="#2ecc71"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎬 MOVIES &amp; SHOWS\n\nSwipe Gestures:\n  → Right = Keep (6 months)\n  ← Left = Block &amp; delete (10s undo)\n  ↓ Down = Super Keep (forever)\n  ↑ Up = Skip\n\nButtons:\n  ✗ Red = Block with undo\n  → Yellow = Skip\n  ✓ Green = Keep\n  Long-press ✓ = Super Keep\n  Long-press → (Shows) = Clean files\n\n━━━━━━━━━━━━━━━━━━━━━━━\n\n🔍 DISCOVER\n\nSwipe right to add to Radarr/Sonarr.\nSwipe left to Dislike. After the 10s\nUndo window, TV Tenderr adds a Radarr\nor Sonarr Import List Exclusion.\nSwipe up or tap yellow to Skip without\nadding an Import List Exclusion.\n\nToggle 🎬/📺 to switch Movies/Shows.\nToggle 🔥/🆕/⭐ to change sort order.\n\nFilters out items already in your library.\n\n━━━━━━━━━━━━━━━━━━━━━━━\n\n📋 HISTORY\n\nTap the clock icon to view history.\nHistory matches your current mode.\nShow Again removes the matching Import\nList Exclusion, then restores the item.\nSkipped items return without changing\nImport List Exclusions.\n\n━━━━━━━━━━━━━━━━━━━━━━━\n\n🔄 PLEX REFRESH\n\nTap refresh icon after deleting to\nupdate your Plex library."
            android:textColor="#888"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp"
            android:background="#11000000"
            android:padding="12dp"
            android:layout_marginBottom="32dp" />

        <!-- Updates -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="App Updates"
            android:textColor="#2ecc71"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvCurrentVersion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="v1.0"
                android:textColor="#aaa"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnCheckUpdates"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Check for Updates"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:backgroundTint="#3498db"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvUpdateStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#888"
            android:textSize="13sp"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>
