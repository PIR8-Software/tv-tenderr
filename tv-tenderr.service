[Unit]
Description=TV Tenderr Backend API
After=network.target

[Service]
Type=simple
User=roy
WorkingDirectory=/home/roy/projects/tv-tenderr
ExecStart=/usr/bin/python3 /home/roy/projects/tv-tenderr/backend.py
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
